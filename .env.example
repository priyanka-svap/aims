# MongoDB connection string
# Local:        mongodb://127.0.0.1:27017/aims
# Atlas (cloud): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/aims
MONGO_URI=

# Server
PORT=5000
NODE_ENV=production

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Default admin user, created automatically on first run if no users exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
AIMS_API_BASE=http://localhost:5000/api
# CORS - comma separated list of allowed origins, use * for any (dev only)
CORS_ORIGIN=*

# OCR.space API key (FREE — 25,000 images/month, no billing needed)
# Free key: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=
